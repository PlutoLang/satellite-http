local socket = require "pluto:socket"

export function mime_parse(str)
	local headers = {}
	for str:split("\r\n") as line do
		local k, v = line:match("(.+)%: (.+)")
		if v then
			headers[k] = v
		end
	end
	return headers
end

export function mime_unparse(headers)
	local str = ""
	for k, v in headers do
		str ..= k..": "..v.."\r\n"
	end
	return str
end

export class HttpResponse
	_status = "200 OK"
	headers_sent = false -- read only

	function __construct(s)
		self.socket = s
		self._headers = {
			["Connection"] = "keep-alive",
			["Server"] = "PlutoLang/satellite-http",
		}
	end

	function status(value)
		assert(not self.headers_sent, "headers already sent")
		self._status = value
		return self
	end

	function hasHeader(name)
		return self._headers[name] ~= nil
	end

	function getHeader(name)
		return self._headers[name]
	end

	function setHeader(name, value)
		assert(not self.headers_sent, "headers already sent")
		self._headers[name] = value
		return self
	end

	function _sendHeaders()
		--assert(not self.headers_sent, "headers already sent")
		self.socket:send("HTTP/1.1 "..self._status.."\r\n"..mime_unparse(self._headers).."\r\n")
		self.headers_sent = true
	end

	function send(data)
		if not self.headers_sent then
			self._headers["Transfer-Encoding"] = "chunked"
			self:_sendHeaders()
		else
			assert(self._headers["Transfer-Encoding"] == "chunked", "headers already sent and not chunked")
		end
		self.socket:send(string.format("%x", #data).."\r\n"..data.."\r\n")
		return self
	end

	function html(data)
		self:setHeader("Content-Type", "text/html; charset=utf-8")
		self["end"](self, data)
	end

	function text(data)
		self:setHeader("Content-Type", "text/plain; charset=utf-8")
		self["end"](self, data)
	end
end
function HttpResponse.end(self, data) -- Workaround for https://github.com/PlutoLang/Pluto/issues/1531
	assert(not self._finished, "response already sent")
	if self.headers_sent and self._headers["Transfer-Encoding"] == "chunked" then
		if data then
			self:send(data)
		end
		self.socket:send("0\r\n\r\n")
	else
		data ??= ""
		self._headers["Transfer-Encoding"] = nil
		self._headers["Content-Length"] = #data
		self.socket:send("HTTP/1.1 "..self._status.."\r\n"..mime_unparse(self._headers).."\r\n"..data)
		self.headers_sent = true
	end
	self._finished = true
end

export class HttpServer
	function __construct(public onrequest)
	end

	function accept(s)
		if self.onaccept then
			self.onaccept(s)
		end
		while data := s:recv() do
			local headers_start, method, path = select(2, data:find("([A-Z]+) (.+) HTTP%/%d%.%d\r\n"))
			if not path then
				s:send("HTTP/1.1 400 Bad Request\r\n\r\n")
				break
			end
			local headers_end, body_start = data:find("\r\n\r\n")
			local headers = mime_parse(data:sub(headers_start + 1, headers_end - 1))
			local body
			if headers["Content-Length"] then
				body = data:sub(body_start + 1)
				local content_length = tonumber(headers["Content-Length"])
				while #body < content_length do
					local app = s:recv()
					if not app then
						break 2
					end
					body ..= app
				end
			end
			local request = $object(method, path, headers, body)
			request.socket = s
			request.rawdata = data
			local response = new HttpResponse(s)
			xpcall(function()
				local pod = self.onrequest(request, response)
				if type(pod) == "string" then
					pod = { body = pod }
				end
				if pod then
					if pod.status then
						response:status(pod.status)
					end
					if pod.headers then
						for k, v in pod.headers do
							response:setHeader(k, v)
						end
					end
					assert(not response._finished, "response:end() must not be called when returning a response table")
					response["end"](response, pod.body) -- Workaround for https://github.com/PlutoLang/Pluto/issues/1532
				else
					if not response._finished then
						response["end"](response)
					end
				end
			end, function(err)
				err = debug.traceback(err, 2)
				if not response._finished then
					if not response.headers_sent then
						response:status("500")
					end
					response["end"](response, err)
				end
				if self.onerror then
					self.onerror(err)
				end
			end)
		end
		if self.onclose then
			self.onclose(s)
		end
	end

	function bind(sched, port)
		return socket.bind(sched, port, |s| -> self:accept(s))
	end
end
