local scheduler = require "pluto:scheduler"
local { HttpServer } = dofile(io.part(debug.getinfo(1, "S").source:sub(2)).."/core.pluto")

export class HttpRouter
	function __construct()
		self._routes = {}
	end

	function get(path, handler)
		self._routes[path] ??= {}
		self._routes[path].GET = handler
		return self
	end

	function post(path, handler)
		self._routes[path] ??= {}
		self._routes[path].POST = handler
		return self
	end

	function handleRequest(request, ...)
		if route := self._routes[request.path] then
			if handler := route[request.method] then
				return handler(request, ...)
			end
			return {
				status = "405 :(",
				headers = {
					["Allow"] = route:keys():concat(", "),
				},
			}
		end
		return { status = "404 :(" }
	end

	function bind(...)
		if not self.server then
			-- @pluto_warnings disable-next (shadowing vararg table)
			self.server = new HttpServer(|...| -> self:handleRequest(...))
			self._scheduler = new scheduler()
		end
		return self.server:bind(self._scheduler, ...)
	end

	function run()
		self._scheduler:run()
	end
end
